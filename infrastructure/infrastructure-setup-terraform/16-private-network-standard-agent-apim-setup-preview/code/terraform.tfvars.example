# Example configuration for private network standard agent with API Management

# Azure region
location = "eastus2"

# AI Foundry configuration
ai_services_name_prefix = "foundry"
project_name            = "private-apim-agent-project"

# API Management configuration (used only when apim_mode = "create-internal")
# apim_sku             = "Developer" # Use Developer for testing, Premium for production
# apim_publisher_name  = "AI Foundry Publisher"
# apim_publisher_email = "admin@example.com"

# ---- APIM mode ----
# "create-internal" (default): create a new APIM here in Internal VNet mode.
# "byo-standardv2":            do NOT create APIM/subnet_apim/NSG. Create a Gateway private
#                              endpoint pointing at an existing StandardV2 APIM and register it
#                              in privatelink.azure-api.net.
#
apim_mode                 = "byo-standardv2"
existing_apim_id          = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.ApiManagement/service/<apim-name>"
existing_apim_gateway_url = "https://<apim-name>.azure-api.net"

# Reuse an existing private endpoint for the BYO APIM instead of creating a new one.
# When false, this template skips both the PE and its DNS A-record in privatelink.azure-api.net.
# Requires that the spoke VNet already has private DNS resolution to the APIM.
create_apim_pe = false

# Model configuration
model_name     = "gpt-4o"
model_version  = "2024-11-20"
model_capacity = 10

# IMPORTANT NOTES:
# 1. API Management deployment can take 30-45 minutes (create-internal mode)
# 2. APIM with Internal VNet requires additional DNS configuration
# 3. Additional APIM policies and configurations need to be set up manually or with additional Terraform resources
# 4. Consider using Application Gateway if you need external access to internal APIM

# ---- Central / cross-subscription Private DNS ----
# REFERENCE existing private DNS zones that live in a different RG or subscription (central DNS).
# Set resource_group_name = "" to have this deployment CREATE the zone locally instead.
#
# When referencing existing zones, the hub team must have already:
#   1. Pre-created a VNet link from each zone to this spoke VNet (this template will not create one).
#   2. Granted the deploying identity "Private DNS Zone Contributor" on the central DNS RG so the
#      private endpoint can register its A-record.

existing_dns_zones = {
  "privatelink.services.ai.azure.com"       = { subscription_id = "<hub-sub-id>", resource_group_name = "rg-central-dns" }
  "privatelink.openai.azure.com"            = { subscription_id = "<hub-sub-id>", resource_group_name = "rg-central-dns" }
  "privatelink.cognitiveservices.azure.com" = { subscription_id = "<hub-sub-id>", resource_group_name = "rg-central-dns" }
  "privatelink.blob.core.windows.net"       = { subscription_id = "<hub-sub-id>", resource_group_name = "rg-central-dns" }
  "privatelink.search.windows.net"          = { subscription_id = "<hub-sub-id>", resource_group_name = "rg-central-dns" }
  "privatelink.documents.azure.com"         = { subscription_id = "<hub-sub-id>", resource_group_name = "rg-central-dns" }
  "privatelink.azure-api.net"               = { subscription_id = "<hub-sub-id>", resource_group_name = "rg-central-dns" }
}

# Note on privatelink.azure-api.net:
#   - create-internal mode: this template does NOT create a PE for APIM (Internal VNet mode has no
#     PE), so after deploy add an A record manually in the zone:
#       <apim-name>.azure-api.net  ->  <APIM private IP>
#     (and the same for portal/management/scm/developer hostnames if used).
#   - byo-standardv2 mode:   the BYO APIM Gateway PE auto-registers its A record in this zone, so
#     point it at your central DNS subscription/RG and no manual record is needed.

# ---- BYO shared resources ----
# Each block below is independent. Uncomment and fill in only the ones you want to reuse; leave
# the rest commented to have this template create them. Cross-subscription is supported for
# VNet / Storage / Search / Cosmos (the existing resource may live in any sub the deploying
# identity can read; the PE into it is always created in the spoke RG/sub).

# Resource group (must be in the deployment subscription)
existing_resource_group_name = "rg-foundry-shared"

# Virtual network + required subnet names within it
# - existing_pe_subnet_name:    subnet that will host the private endpoints created by this template.
# - existing_agent_subnet_name: subnet the Foundry agent runtime is injected into (networkInjections).
#                               MUST be a separate subnet from the PE subnet. This template will add a
#                               Microsoft.App/environments delegation to it (must be empty for delegation to succeed).
existing_vnet_id           = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>"
existing_pe_subnet_name    = "pe-subnet"
existing_agent_subnet_name = "agent-subnet"
existing_apim_subnet_name  = "" # only needed if apim_mode = "create-internal"

# Storage account
existing_storage_account_id = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<name>"

# AI Search service
existing_ai_search_id = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Search/searchServices/<name>"

# Cosmos DB account
existing_cosmos_db_account_id = "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.DocumentDB/databaseAccounts/<name>"

# ---- Name overrides for resources this template CREATES ----
# Each is used ONLY when the matching existing_*_id above is empty (i.e. this template creates the
# resource). Ignored in BYO mode. Leave commented out to fall back to the auto-generated names
# (aifoundry<rand>stor / aifoundry-<rand>-search / aifoundry<rand>cosmos).
#
# storage_account_name   = "mystorageacctname"   # 3-24 chars, lowercase letters/digits, globally unique
# ai_search_name         = "my-search-name"      # 2-60 chars, lowercase letters/digits/hyphens, globally unique
# cosmos_db_account_name = "my-cosmos-name"      # 3-44 chars, lowercase letters/digits/hyphens, globally unique

# RBAC needed on the existing resources (deploying identity):
#   - Storage:  Owner or User Access Administrator (to grant Foundry MI the Blob Data Contributor role)
#   - Search:   Owner or User Access Administrator (Search Index/Service Data Contributor + Service Contributor)
#   - Cosmos:   Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments/write
#   - VNet:     Network Contributor on the PE subnet (to create the PE NIC) and the subnet must
#               have privateEndpointNetworkPolicies = Disabled
