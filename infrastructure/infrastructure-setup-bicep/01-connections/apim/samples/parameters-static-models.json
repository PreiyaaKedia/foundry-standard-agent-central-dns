{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "connectionScope": {
      "_comment": "'project' (default) creates a project-scoped connection. 'account' creates an account-scoped connection shared across all projects in the Foundry account.",
      "value": "project"
    },
    "projectResourceId": {
       "_comment": "Required when connectionScope = 'project'. Leave default/empty when connectionScope = 'account'.",
      "value": "/subscriptions/YOUR-SUBSCRIPTION-ID/resourceGroups/YOUR-RG/providers/Microsoft.CognitiveServices/accounts/YOUR-AI-FOUNDRY-ACCOUNT/projects/YOUR-PROJECT"
    },
    "accountResourceId": {
      "_comment": "Required when connectionScope = 'account'. Leave empty when connectionScope = 'project'.",
      "value": "/subscriptions/YOUR-SUBSCRIPTION-ID/resourceGroups/YOUR-RG/providers/Microsoft.CognitiveServices/accounts/YOUR-AI-FOUNDRY-ACCOUNT"
    },
    "apimResourceId": {
      "value": "/subscriptions/YOUR-SUBSCRIPTION-ID/resourceGroups/YOUR-APIM-RG/providers/Microsoft.ApiManagement/service/YOUR-APIM-SERVICE"
    },
    "apiName": {
      "value": "YOUR-API-NAME"
    },
    "connectionName": {
      "value": "YOUR-CONNECTION-NAME"
    },
    "authType": {
      "_comment": "Set to ApiKey or ProjectManagedIdentity",
      "value": "ApiKey"
    },
    "isSharedToAll": {
      "value": false
    },
    "deploymentInPath": {
      "_comment": "true or false - Set based on setup guide to avoid 404 errors in agents",
      "value": "false"
    },
    "inferenceAPIVersion": {
      "_comment": "Set a proper value or leave empty if your APIM backend does not need it. Set based on setup guide to avoid 404 errors in agents",
      "value": ""
    },
    "deploymentAPIVersion": {
      "value": ""
    },
    "staticModels": {
      "value": [
        {
          "name": "YOUR-MODEL-DEPLOYMENT-NAME-1",
          "properties": {
            "model": {
              "name": "YOUR-MODEL-NAME-1",
              "version": "YOUR-MODEL-VERSION-1",
              "format": "OpenAI"
            }
          }
        },
        {
          "name": "YOUR-MODEL-DEPLOYMENT-NAME-2",
          "properties": {
            "model": {
              "name": "YOUR-MODEL-NAME-2",
              "version": "YOUR-MODEL-VERSION-2",
              "format": "OpenAI"
            }
          }
        }
      ]
    }
  }
}
